{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skyline migration judge verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "confidence", "reasons", "evidenceHash"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["accept", "reject"],
      "description": "accept = 可以进入人工验收；reject = 这次改动不能要"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "对「没有引入回归」的信心"
    },
    "reasons": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "quote"],
        "properties": {
          "layer": { "type": "string", "enum": ["l0", "l1", "l2", "l3", "l4"] },
          "quote": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "evidenceHash": {
      "type": "string",
      "description": "对传入证据的摘要；同证据复用结论，换证据才允许重判"
    }
  }
}
